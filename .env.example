# Required
DISCORD_TOKEN=your-bot-token

# Forum channel where each report becomes its own post (required)
REVIEW_FORUM_ID=

# Server where bans are applied. Optional: defaults to the server that owns the review forum.
# CYBERBYTE_GUILD_ID=

# Channel for public scam warnings. Optional: the "Public warning" action is refused until this is set.
# PUBLIC_WARNING_CHANNEL_ID=

# Role allowed to review cases (besides the bot owner). Optional: if unset, only the bot owner can review.
# REVIEWER_ROLE_ID=

# Replaces the appeal instructions in the DM people get. Optional: leave unset to use the built-in
# text, which points at the Appeal button and the /appeal command.
# APPEAL_TEXT=If you believe this was a mistake, contact the staff and quote your case number.

# Storage locations. Optional.
# CYBERBOT_DB=cyberbot.db
# SCAMMER_FILE=scammers.json
